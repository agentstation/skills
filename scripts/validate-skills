#!/usr/bin/env python3
"""Validate that every skills/*/SKILL.md has YAML frontmatter with name + description."""
from __future__ import annotations

import sys
from pathlib import Path


def parse_frontmatter(text: str) -> dict[str, str] | None:
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return None
    fields: dict[str, str] = {}
    for line in lines[1:]:
        if line.strip() == "---":
            return fields
        if ":" in line and not line.startswith(" "):
            key, _, value = line.partition(":")
            fields[key.strip()] = value.strip().strip('"').strip("'")
    return None


def main() -> int:
    repo_root = Path(__file__).resolve().parent.parent
    skills_dir = repo_root / "skills"
    errors: list[str] = []
    checked = 0
    for skill_md in sorted(skills_dir.glob("*/SKILL.md")):
        checked += 1
        fm = parse_frontmatter(skill_md.read_text(encoding="utf-8"))
        if fm is None:
            errors.append(f"{skill_md}: missing or unterminated YAML frontmatter")
            continue
        for key in ("name", "description"):
            if not fm.get(key):
                errors.append(f"{skill_md}: frontmatter missing required '{key}'")
        expected = skill_md.parent.name
        if fm.get("name") and fm["name"] != expected:
            errors.append(f"{skill_md}: name '{fm['name']}' != directory '{expected}'")
    if errors:
        for err in errors:
            print(f"FAIL {err}", file=sys.stderr)
        return 1
    print(f"ok: {checked} skill(s) valid")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
